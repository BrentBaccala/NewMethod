# ---------- LaTeX build products ----------
*.aux
*.log
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.fdb_latexmk

# hyperref bookmark file.  CAREFUL: the sage drivers also write their
# results as *.out, so this pattern is deliberately narrowed below.
# LaTeX .out files always have a sibling .tex; the data files do not.
*.out
!hydrogen-*.out
!joca-*.out

# ---------- beamer (NewMethod-talk.tex) ----------
*.nav
*.snm
*.vrb

# ---------- comment package scratch file ----------
# \excludecomment in NewMethod.tex, results.tex, regularity-counterexamples.tex
*.cut

# ---------- sage / python ----------
*.sage.py
__pycache__/

# transient scratch from the sage drivers.  The *results* are the
# hydrogen-*.out / joca-*.out files un-ignored above.
current.output
*.resumelog

# ---------- generated PDFs ----------
# Dropped from history at the 2026-09-15 split out of BrentBaccala/Papers.
# Every PDF here is a pdflatex product of a sibling .tex -- none is an
# \includegraphics input.  Rebuild with: pdflatex <file>.tex
*.pdf

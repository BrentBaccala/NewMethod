-- NewMethod paper: the xi ("first") separated equation, in FriCAS.
--
--     d/dxi ( xi df1/dxi ) + [ (1/2) E xi - (1/4) m^2/xi + beta1 ] f1 = 0
--
-- Companion to f1-ode.wls, f1-ode-sympy.py, f1-ode-sage.sage.
-- See cas-comparison.tex for the write-up.
--
-- Run:  fricas -nosman < f1-ode-fricas.input
--   (-nosman must be the FIRST argument; without it FriCAS starts the
--    session manager, which needs a tty and hangs on piped stdin.)
--
-- Install (no root required):
--   mamba create -n fricas -c conda-forge fricas
--   mamba install -n fricas -c conda-forge 'sbcl=2.4.8'
-- The second line is REQUIRED: conda's fricas 1.3.13 core is built against
-- SBCL 2.4.8, but the dependency solver installs a newer SBCL, and the
-- mismatch aborts at startup with
--   "GC strategy mismatch: runtime uses 1, core built for 38".
--
-- Bottom line: FriCAS solves linear ODEs in the LIOUVILLIAN class (Kovacic).
-- Bessel and confluent hypergeometric functions are not Liouvillian, so
-- FriCAS returns basis = [] for the general equation.  That is a DECISION,
-- not a failure to look: it returns a basis in exactly the cases where a
-- Liouvillian solution exists, and those cases are physically meaningful.

f1 := operator 'f1

--------------------------------------------------------------------------
-- 1.  The equation as it stands, all parameters symbolic.  basis = [].
--------------------------------------------------------------------------
ode := D(xi*D(f1 xi, xi), xi) + (EE*xi/2 - m^2/(4*xi) + b1)*f1(xi)
solve(ode, f1, xi)

-- beta1 = 0 (the Bessel reduction) is likewise not Liouvillian in general.
solve(D(xi*D(f1 xi, xi), xi) + (EE*xi/2 - m^2/(4*xi))*f1(xi), f1, xi)

--------------------------------------------------------------------------
-- 2.  Control: the solver works, it just works on a different class.
--------------------------------------------------------------------------
y := operator 'y
solve(D(y x, x, 2) - y x, y, x)                          -- [e^x, e^-x]
solve(x^2*D(y x, x, 2) + x*D(y x, x) - y x, y, x)        -- [(x^2-1)/x, (x^2+1)/x]
solve(D(y x, x, 2) + (1/x)*D(y x, x), y, x)              -- [1, log x]

--------------------------------------------------------------------------
-- 3.  beta1 = 0, E = 2:  xi^2 f1'' + xi f1' + (xi^2 - m^2/4) f1 = 0,
--     i.e. Bessel of order m/2.  Bessel_nu is Liouvillian iff nu is a
--     half-integer, i.e. iff m is ODD.  FriCAS reproduces exactly that.
--------------------------------------------------------------------------
solve(D(xi*D(f1 xi, xi), xi) + (xi -  1/(4*xi))*f1(xi), f1, xi)  -- m=1: SOLVED
solve(D(xi*D(f1 xi, xi), xi) + (xi -  4/(4*xi))*f1(xi), f1, xi)  -- m=2: []
solve(D(xi*D(f1 xi, xi), xi) + (xi -  9/(4*xi))*f1(xi), f1, xi)  -- m=3: SOLVED
solve(D(xi*D(f1 xi, xi), xi) + (xi - 16/(4*xi))*f1(xi), f1, xi)  -- m=4: []

--------------------------------------------------------------------------
-- 4.  The interesting one.  With E = -2 (so k = sqrt(-E/2) = 1) the
--     confluent hypergeometric series truncates to a Laguerre polynomial
--     -- and the solution becomes Liouvillian -- exactly when
--
--         beta1 = 2k( (1+m)/2 + n1 ),   n1 = 0, 1, 2, ...
--
--     which is the bound-state quantization condition, n1 the parabolic
--     quantum number.  FriCAS returns a basis at precisely those beta1
--     and [] in between.  Its Liouvillian decision procedure is, here,
--     detecting the quantization of the energy.
--------------------------------------------------------------------------
solve(D(xi*D(f1 xi, xi), xi) + (-xi + 1)*f1(xi), f1, xi)          -- m=0,n1=0: SOLVED
solve(D(xi*D(f1 xi, xi), xi) + (-xi + 3)*f1(xi), f1, xi)          -- m=0,n1=1: SOLVED
solve(D(xi*D(f1 xi, xi), xi) + (-xi + 2)*f1(xi), f1, xi)          -- m=0, not quantized: []
solve(D(xi*D(f1 xi, xi), xi) + (-xi - 1/xi + 3)*f1(xi), f1, xi)   -- m=2,n1=0: SOLVED
solve(D(xi*D(f1 xi, xi), xi) + (-xi - 1/xi + 2)*f1(xi), f1, xi)   -- m=2, not quantized: []

)quit
